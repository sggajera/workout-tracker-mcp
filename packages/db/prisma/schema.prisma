generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WorkoutEntry {
  id        String   @id @default(cuid())
  date      DateTime
  exercise  String
  setNumber Int
  repsDone  Int?
  weight    Float?
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}